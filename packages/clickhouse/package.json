{
  "name": "@alchemy.run/clickhouse",
  "version": "2.0.0-beta.85",
  "description": "ClickHouse Cloud resources for Alchemy.",
  "keywords": [
    "alchemy",
    "clickhouse",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/clickhouse"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ClickPipes": "./src/ClickPipes/index.ts",
    "./SQL": "./src/SQL/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./ClickPipes": {
        "types": "./lib/ClickPipes/index.d.ts",
        "bun": "./src/ClickPipes/index.ts",
        "worker": "./src/ClickPipes/index.ts",
        "default": "./lib/ClickPipes/index.js"
      },
      "./SQL": {
        "types": "./lib/SQL/index.d.ts",
        "bun": "./src/SQL/index.ts",
        "worker": "./src/SQL/index.ts",
        "default": "./lib/SQL/index.js"
      },
      "./SQL/internal/*": null,
      "./*/internal": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/sql": "workspace:*",
    "@distilled.cloud/clickhouse": "workspace:*",
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/clickhouse/Contributions"
    ]
  }
}
